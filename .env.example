# Postgres
POSTGRES_DB=aikocstudio
POSTGRES_USER=aikocstudio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=aikocstudio-media
# Base URL clients use to fetch uploaded files. The bucket is created with a
# public-read policy automatically on first upload (see MinioFileStorageService) —
# no manual `mc anonymous set` step needed.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Auth
JWT_SECRET=replace-with-a-real-256-bit-secret
JWT_ISSUER=AiKocStudio
JWT_AUDIENCE=AiKocStudio

# First-admin bootstrap (only used once, when the Users table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-then-change-it-after-first-login

# API
API_PORT=5000

# AI providers (filled for real in Phase 4)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
